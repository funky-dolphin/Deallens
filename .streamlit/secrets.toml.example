# Copy this into Streamlit Cloud under  Settings > Secrets  (or save it
# locally as .streamlit/secrets.toml, which is gitignored).
#
# The application reads Streamlit secrets first, then the environment, so a
# local .env works for development and this works for a deployment.

ANTHROPIC_API_KEY = "sk-ant-..."

# This is the only setting a hosted copy needs.
#
# Do NOT set DEALLENS_DB. Left unset, each visitor gets a private copy of the
# sample database shipped with the repository -- three filings already read
# and extracted -- so they see results immediately and their uploads and
# corrections do not reach anyone else. Setting it points every visitor at one
# shared file instead.
